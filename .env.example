# Copy this file to .env and fill in a provider/model you are allowed to use.
# OpenAI-compatible base URL example: https://api.openai.com/v1
# Local Ollama-compatible endpoint example: http://localhost:11434/v1
CRIS_LLM_BASE_URL=https://api.openai.com/v1
CRIS_LLM_API_KEY=
CRIS_LLM_MODEL=gpt-6-luna
CRIS_LLM_TIMEOUT_SECONDS=60
# Includes hidden reasoning tokens as well as the visible JSON answer.
CRIS_LLM_MAX_COMPLETION_TOKENS=8000
# Demo default: accept snapshots up to 24 hours old. Tighten this for production.
CRIS_MONITORING_MAX_AGE_MINUTES=1440
